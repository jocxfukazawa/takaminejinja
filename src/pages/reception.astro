---
/**
 * 当日受付（参拝の方がご自分のスマホや神社のタブレットで入力する）。
 * 境内の QR コード（/reception/?k=その日だけの記号）から開く。検索には出さない。
 * 受け付ける日時と行事の名前は、Airtable の「当日受付の日」の表。行事の名前があれば、ページの上に出す。
 */
import FixedPage from '../layouts/FixedPage.astro';
import ReservationForm from '../components/ReservationForm.astro';
---
<FixedPage slug="reception" narrow>
  <Fragment slot="head">
    <meta name="robots" content="noindex, nofollow" />
    <script is:inline src="https://challenges.cloudflare.com/turnstile/v0/api.js" async defer></script>
  </Fragment>

  <p class="p-reception-event" id="js-reception-event" hidden></p>
  <ReservationForm reception />
</FixedPage>
