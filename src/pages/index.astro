---
import Base from '../layouts/Base.astro';
import Headline from '../components/Headline.astro';
import NewsList from '../components/NewsList.astro';
import EventList from '../components/EventList.astro';
import BlogList from '../components/BlogList.astro';
import { UPLOADS, LOGO_WHITE, news, events, blog } from '../data/site';
---
<Base front>
  <div class="p-hero">
    <video class="p-hero__video" autoplay loop muted playsinline poster={`${UPLOADS}/2023/06/mv_01.png`}>
      <source src={`${UPLOADS}/2023/06/top_movie.mov`} type="video/mp4" />
    </video>
    <a class="p-hero__arrow" href="#intro" aria-label="下へ"></a>
    <!-- 開いたときの演出：にじんだ色の上に白いロゴが現れ、色がざらっと溶けて動画になる -->
    <div class="p-intro" id="js-intro" aria-hidden="true">
      <canvas class="p-intro__canvas" id="js-intro-canvas"></canvas>
      <div class="p-intro__inner">
        <img class="p-intro__logo" src={LOGO_WHITE} alt="" width="184" height="206" fetchpriority="high" />
        <p class="p-intro__copy">大切な人の<br />幸せを祈る場所</p>
      </div>
    </div>
    <script is:inline>
      // 動きを減らす設定の方には出さない。そうでなければ、演出のあいだ上のロゴとメニューを隠す
      if (matchMedia('(prefers-reduced-motion: reduce)').matches) document.getElementById('js-intro').remove();
      else document.body.classList.add('is-intro');
    </script>
  </div>

  <section class="p-index-intro" id="intro">
    <div class="p-index-intro__text l-inner">
      <h2 class="p-index-intro__title">大切な人の<br />幸せを祈る場所</h2>
      <p class="p-index-intro__desc">日本人が古来より大切にしてきた家族。<br />高嶺神社は、<br />『須佐之男命（スサノオノミコト）』と<br />そのご家族を祀る珍しい神社です。<br />千年以上前から、大切な人を想う神聖な場所として<br />多くの人々に親しまれてきました。<br />この神聖な地で、あなた自身と、<br />あなたの大切な人の幸せを祈りませんか。<br /><br />『家庭円満』のほか、厄除けや五穀豊穣、<br />縁結びのご利益をいただけます。</p>
    </div>
    <div class="p-index-intro__images l-inner">
      {['contents_01', 'contents_02', 'contents_03'].map((name) => (
        <div><img src={`${UPLOADS}/2023/06/${name}.png`} alt="" loading="lazy" width="400" height="300" /></div>
      ))}
    </div>
    <p class="p-index-button"><a class="p-btn" href="/about/">高嶺神社について</a></p>
  </section>

  <section class="p-index-section p-index-section--gray">
    <div class="l-inner">
      <Headline>お知らせ</Headline>
      <NewsList items={news.slice(0, 6)} />
      <p class="p-index-button"><a class="p-btn" href="/news/">お知らせ一覧</a></p>
    </div>
  </section>

  <section class="p-index-section">
    <div class="l-inner">
      <Headline>祭典・行事のご案内</Headline>
      <EventList items={events} limit={6} />
      <p class="p-index-button"><a class="p-btn" href="/event/">祭典・行事についてはこちら</a></p>
    </div>
  </section>

  <section class="p-index-prayer">
    <video class="p-index-prayer__video" autoplay loop muted playsinline>
      <source src={`${UPLOADS}/2023/06/contents_movie.mov`} type="video/mp4" />
    </video>
    <div class="p-index-prayer__inner">
      <h2 class="p-index-prayer__title">人生の節目で<br />平穏を祈る</h2>
      <p><a class="p-btn p-btn--vertical" href="/prayer/">ご祈願・ご祈祷</a></p>
    </div>
  </section>

  <section class="p-index-section">
    <div class="l-inner">
      <Headline>ブログ</Headline>
      <BlogList items={blog.slice(0, 4)} />
      <p class="p-index-button"><a class="p-btn" href="/blog/">ブログ一覧</a></p>
    </div>
  </section>
</Base>

<script>
  // トップの演出（案B）。色のにじみを canvas に描き、最後は細かい粒で溶けるように消す
  const intro = document.getElementById('js-intro');
  const canvas = document.getElementById('js-intro-canvas') as HTMLCanvasElement | null;
  if (intro && canvas) {
    const ctx = canvas.getContext('2d', { willReadFrequently: true })!;
    const SCALE = 3; // 3px ごとの粒
    let w = 0, h = 0, noise = new Float32Array(0);
    const resize = () => {
      w = Math.max(1, Math.ceil(intro.clientWidth / SCALE));
      h = Math.max(1, Math.ceil(intro.clientHeight / SCALE));
      canvas.width = w; canvas.height = h;
      noise = new Float32Array(w * h);
      for (let i = 0; i < noise.length; i++) noise[i] = Math.random();
    };
    resize();
    // お印のピンク、若草の緑、山吹の黄、空の青み
    const blobs = [
      { c: [232, 84, 113], x: .28, y: .62, r: .75, sx: .07, sy: .05, sp: .00035 },
      { c: [126, 186, 122], x: .78, y: .35, r: .8, sx: .06, sy: .08, sp: .00028 },
      { c: [244, 190, 96], x: .55, y: .2, r: .6, sx: .09, sy: .05, sp: .00042 },
      { c: [150, 200, 190], x: .85, y: .85, r: .6, sx: .05, sy: .06, sp: .0003 },
    ];
    const draw = (t: number) => {
      ctx.globalCompositeOperation = 'source-over';
      ctx.fillStyle = 'rgb(246, 214, 190)';
      ctx.fillRect(0, 0, w, h);
      const m = Math.max(w, h);
      for (const b of blobs) {
        const x = (b.x + Math.sin(t * b.sp) * b.sx) * w;
        const y = (b.y + Math.cos(t * b.sp * 1.3) * b.sy) * h;
        const g = ctx.createRadialGradient(x, y, 0, x, y, b.r * m);
        g.addColorStop(0, `rgba(${b.c.join(',')}, .95)`);
        g.addColorStop(1, `rgba(${b.c.join(',')}, 0)`);
        ctx.fillStyle = g;
        ctx.fillRect(0, 0, w, h);
      }
    };
    const DISSOLVE_AT = 3800, DISSOLVE_MS = 1300;
    const start = performance.now();
    let raf = 0;
    const frame = (now: number) => {
      const t = now - start;
      draw(t);
      // canvas が描き始めたら、下に敷いた同じ色のにじみは外す（溶けたところから動画が見えるように）
      intro.classList.add('is-canvas');
      if (t > DISSOLVE_AT) {
        // 粒ごとに決めた順で透明にしていく（ざらっと溶ける）
        const p = Math.min(1, (t - DISSOLVE_AT) / DISSOLVE_MS);
        const img = ctx.getImageData(0, 0, w, h);
        const d = img.data;
        const edge = .35;
        for (let i = 0; i < noise.length; i++) {
          const a = (noise[i] - (p * (1 + edge) - edge)) / edge;
          d[i * 4 + 3] = a <= 0 ? 0 : a >= 1 ? 255 : a * 255;
        }
        ctx.putImageData(img, 0, 0);
        if (p >= 1) {
          intro.remove();
          document.body.classList.remove('is-intro');
          return;
        }
      }
      raf = requestAnimationFrame(frame);
    };
    raf = requestAnimationFrame(frame);
    requestAnimationFrame(() => intro.classList.add('is-shown'));
    setTimeout(() => intro.classList.add('is-leaving'), DISSOLVE_AT - 300);
    window.addEventListener('resize', resize);
  }
</script>

