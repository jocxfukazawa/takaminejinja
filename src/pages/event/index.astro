---
import Base from '../../layouts/Base.astro';
import PageHeader from '../../components/PageHeader.astro';
import EventList from '../../components/EventList.astro';
import { pages, events } from '../../data/site';

const page = pages.event;
---
<Base title={page.title} description={page.description}>
  <PageHeader title={page.title} img={page.headerImg} crumbs={[{ label: page.title }]} />
  <div class="l-contents l-inner">
    <h1 class="u-visually-hidden">{page.title}</h1>
    <EventList items={events} />
  </div>
</Base>
