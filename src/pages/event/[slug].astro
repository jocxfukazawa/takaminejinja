---
import Base from '../../layouts/Base.astro';
import Breadcrumb from '../../components/Breadcrumb.astro';
import Headline from '../../components/Headline.astro';
import EventList from '../../components/EventList.astro';
import { events, type EventEntry } from '../../data/site';

export function getStaticPaths() {
  return events.map((entry) => ({ params: { slug: entry.slug }, props: { entry } }));
}

interface Props {
  entry: EventEntry;
}
const { entry } = Astro.props;
const related = events.filter((e) => e.slug !== entry.slug);
---
<Base title={entry.title} description={entry.description} ogImage={entry.img}>
  <Breadcrumb items={[{ label: '祭典・行事', href: '/event/' }, { label: entry.title }]} />
  <div class="l-contents l-inner">
    <article class="p-entry">
      <header class="p-entry__header">
        <Headline tag="h1" class="p-entry__title">{entry.title}</Headline>
        <p class="p-entry__date">{entry.dateText}</p>
        {entry.img && <figure class="p-entry__img"><img src={entry.img} alt="" /></figure>}
      </header>
      <div class="p-entry__body" set:html={entry.html} />
    </article>
    <section class="p-related">
      <Headline>その他の祭典・行事</Headline>
      <EventList items={related} limit={4} />
    </section>
  </div>
</Base>
