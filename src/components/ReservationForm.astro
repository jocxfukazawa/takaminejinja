---
/**
 * ご祈祷の予約フォーム（予約ページと事前申し込みのページで共通）
 *
 * advance を付けると「事前申し込み」になる：時刻は選ばず、ご来社予定日だけを選ぶ。
 * 黒星祈願祭など、予約を受けずに来られた順にご案内する日のためのもの（src/lib/reservation.ts の ADVANCE_DATES）
 *
 * reception を付けると「当日受付」になる：Airtable の「当日受付の日」の日に、参拝の方がその場で入力する（/reception/）。
 * 日時・メールアドレス・納め方は聞かず、初穂料は計算した金額を入れておき、増やせるようにする。
 * 送信すると受付が確定し、申込書がプリンターから出る
 */
import { PRAYERS, PRAYER_OTHER, PHONE, MAX_PERSONS, ADVANCE_CUTOFF_HOUR } from '../lib/reservation';

interface Props {
  advance?: boolean;
  reception?: boolean;
}
const { advance = false, reception = false } = Astro.props;
const mode = reception ? 'reception' : advance ? 'advance' : 'reserve';

// Turnstile のサイトキー（未設定時は Cloudflare 公式のテスト用キー＝常に成功）
const siteKey = import.meta.env.PUBLIC_TURNSTILE_SITE_KEY || '1x00000000000000000000AA';
---
<form class="p-contact-form p-reserve" id="js-reserve-form" action="/api/reservation" method="post" novalidate data-mode={mode}>
  {reception ? (
    <>
      <input type="hidden" name="mode" value="reception" />
      <input type="hidden" name="k" value="" />
      <input type="hidden" name="method" value="来社" />
      <input type="hidden" name="payment" value="当日ご社頭でお納め" />
      <input type="hidden" id="date" name="date" value="" />
    </>
  ) : advance ? (
    <>
      <input type="hidden" name="mode" value="advance" />
      <input type="hidden" name="method" value="来社" />
      <h2 class="p-reserve__heading">ご来社予定日</h2>
      <div class="p-contact-form__row">
        <div class="p-contact-form__label"><label for="date">ご来社予定日</label><span class="p-required">必須</span></div>
        <div class="p-contact-form__field">
          <select id="date" name="date" required>
            <option value="">選んでください</option>
          </select>
          <p class="p-reserve__help">お申し込みの締め切りは、ご来社予定日の前日の午後{ADVANCE_CUTOFF_HOUR - 12}時です。時刻のご予約ではありません。当日は、お越しになった順にご案内いたします。</p>
        </div>
      </div>
      <p class="p-contact-form__error" id="js-advance-closed" role="alert" hidden>ただいま、事前のお申し込みを受け付けている日はありません。当日、直接お越しください。</p>
    </>
  ) : (
  <>
  <h2 class="p-reserve__heading">ご祈祷の方法と日時</h2>

  <div class="p-contact-form__row">
    <div class="p-contact-form__label" id="method-label">ご祈祷方法<span class="p-required">必須</span></div>
    <div class="p-contact-form__field p-reserve__choices" role="radiogroup" aria-labelledby="method-label">
      <label><input type="radio" name="method" value="来社" checked /> 神社にお越しになる</label>
      <label><input type="radio" name="method" value="郵送" /> 郵送（御札・御守をお送りします）</label>
      <p class="p-reserve__help">ご参拝が叶わない場合は、郵送でのご祈祷も承っております。ご祈祷の後、御札・御守を郵送いたします。</p>
    </div>
  </div>

  <div data-show="visit">
    <p class="p-reserve__help">30分ごとに1組ずつ承っております。ご家族など、ご一緒に受けられる方は1組でご予約いただけます。選べない日時は、予約で埋まっているか、受付をしていない日時です。</p>
    <div class="p-contact-form__row">
      <div class="p-contact-form__label"><label for="date">日にち</label><span class="p-required">必須</span></div>
      <div class="p-contact-form__field">
        <select id="date" name="date" disabled>
          <option value="">読み込んでいます…</option>
        </select>
      </div>
    </div>
    <div class="p-contact-form__row">
      <div class="p-contact-form__label" id="time-label">時刻<span class="p-required">必須</span></div>
      <div class="p-contact-form__field">
        <div class="p-reserve__times" id="js-times" role="radiogroup" aria-labelledby="time-label">
          <p class="p-reserve__help">先に日にちを選んでください。</p>
        </div>
      </div>
    </div>
    <p class="p-contact-form__error" id="js-slots-error" role="alert" hidden>空いている日時を読み込めませんでした。時間をおいてページを再読み込みしていただくか、お電話（{PHONE}）でご予約ください。</p>
  </div>
  </>
  )}

  <h2 class="p-reserve__heading">ご祈祷を受けられる方</h2>
  <p class="p-reserve__help">ご家族などでご一緒にご祈祷を受けられる場合は、下の「＋ 一緒にご祈祷を受ける方を追加」から、お一人ずつご入力ください（{MAX_PERSONS}名まで）。ご祈願内容は、お一人ずつ（複数でも）お選びいただけます。<br />ご祈祷料は、ご祈願1件につき5千円以上（初宮詣は8千円以上）でお心持ちをお納めいただいております。</p>
  <p class="p-reserve__notice">ここには、<strong>ご祈祷を受けるご本人</strong>のお名前・生年月日をご入力ください。<br /><strong>七五三詣・初宮詣は、お子さまのお名前</strong>です（父母のお名前は、ご祈願内容を選ぶと出る欄にご入力いただきます）。</p>

  <div id="js-persons"></div>
  <p class="p-reserve__add-wrap"><button type="button" class="p-reserve__add" id="js-add-person">＋ 一緒にご祈祷を受ける方を追加</button></p>

  <template id="js-person-template">
    <fieldset class="p-reserve__person" data-person>
      <legend class="p-reserve__person-title">
        <span data-person-label></span>
        <button type="button" class="p-reserve__remove" data-remove>この方を削除</button>
      </legend>
      <div class="p-contact-form__row">
        <div class="p-contact-form__label">お名前<span class="p-required">必須</span></div>
        <div class="p-contact-form__field p-reserve__pair">
          <label><span>姓</span><input name="p__i__-sei" type="text" maxlength="50" required autocomplete="family-name" /></label>
          <label><span>名</span><input name="p__i__-mei" type="text" maxlength="50" required autocomplete="given-name" /></label>
        </div>
      </div>
      <div class="p-contact-form__row">
        <div class="p-contact-form__label">ふりがな<span class="p-required">必須</span></div>
        <div class="p-contact-form__field p-reserve__pair">
          <label><span>せい</span><input name="p__i__-sei-kana" type="text" maxlength="50" required /></label>
          <label><span>めい</span><input name="p__i__-mei-kana" type="text" maxlength="50" required /></label>
        </div>
      </div>
      <div class="p-contact-form__row">
        <div class="p-contact-form__label"><label for="p__i__-special">お名前の特殊文字</label></div>
        <div class="p-contact-form__field">
          <input id="p__i__-special" name="p__i__-special" type="text" maxlength="200" />
          <p class="p-reserve__help">お名前に特殊な文字（旧字体など）がある場合は、文字についての説明をご記入ください。</p>
        </div>
      </div>
      <div class="p-contact-form__row">
        <div class="p-contact-form__label" id="p__i__-gender-label">性別<span class="p-required">必須</span></div>
        <div class="p-contact-form__field p-reserve__choices p-reserve__choices--inline" role="radiogroup" aria-labelledby="p__i__-gender-label">
          <label><input type="radio" name="p__i__-gender" value="男" required /> 男</label>
          <label><input type="radio" name="p__i__-gender" value="女" /> 女</label>
          <label><input type="radio" name="p__i__-gender" value="回答しない" /> 回答しない</label>
        </div>
      </div>
      <div class="p-contact-form__row">
        <div class="p-contact-form__label"><label for="p__i__-birthday">生年月日</label><span class="p-required">必須</span></div>
        <div class="p-contact-form__field">
          <input id="p__i__-birthday" name="p__i__-birthday" type="date" min="1900-01-01" required />
          {(advance || reception) && (
            <div class="p-reserve__fortune" data-fortune hidden aria-live="polite">
              <p data-fortune-text></p>
              <p class="p-reserve__fortune-note">※ 生まれ年から計算した目安です。正確には<a href="/event/kuroboshi/" target="_blank" rel="noopener">黒星祈願祭のページ</a>の黒星・厄年の表でお確かめください。</p>
            </div>
          )}
        </div>
      </div>
      <div class="p-contact-form__row">
        <div class="p-contact-form__label" id="p__i__-prayer-label">ご祈願内容<span class="p-required">必須</span></div>
        <div class="p-contact-form__field">
          <div class="p-reserve__prayers" role="group" aria-labelledby="p__i__-prayer-label" data-prayers>
            {PRAYERS.map((p) => <label><input type="checkbox" name="p__i__-prayer" value={p.name} data-extras={p.extras.join(' ')} /> {p.name}</label>)}
            <label><input type="checkbox" name="p__i__-prayer" value={PRAYER_OTHER} data-extras="other" /> {PRAYER_OTHER}</label>
          </div>
          <p class="p-reserve__help">複数のご祈願をお選びいただけます。</p>
        </div>
      </div>
      <div class="p-contact-form__row" data-extra="other" hidden>
        <div class="p-contact-form__label"><label for="p__i__-prayer-other">ご祈願内容（その他）</label><span class="p-required">必須</span></div>
        <div class="p-contact-form__field"><input id="p__i__-prayer-other" name="p__i__-prayer-other" type="text" maxlength="100" data-required /></div>
      </div>
      <div class="p-contact-form__row" data-extra="haraobi" hidden>
        <div class="p-contact-form__label" id="p__i__-haraobi-label">腹帯のお祓い<span class="p-required">必須</span></div>
        <div class="p-contact-form__field p-reserve__choices" role="radiogroup" aria-labelledby="p__i__-haraobi-label">
          <label><input type="radio" name="p__i__-haraobi" value="あり" data-required /> あり</label>
          <label><input type="radio" name="p__i__-haraobi" value="なし" /> なし</label>
          <p class="p-reserve__help">安産祈願と同時に、腹帯（岩田帯）のお祓いができます。腹帯のお祓いを行う場合、初穂料は8千円以上でお心持ちをお納めいただいております。</p>
        </div>
      </div>
      <div class="p-contact-form__row" data-extra="parents" hidden>
        <div class="p-contact-form__label">父母のお名前<span class="p-required">必須</span></div>
        <div class="p-contact-form__field" data-parents>
          {[['father', '父', '高嶺　太郎', 'たかみね　たろう'], ['mother', '母', '高嶺　花子', 'たかみね　はなこ']].map(([key, label, name, kana]) => (
            <div class="p-reserve__parent">
              <span class="p-reserve__parent-label">{label}</span>
              <div class="p-reserve__pair">
                <label><span>お名前</span><input name={`p__i__-${key}`} type="text" maxlength="100" placeholder={name} /></label>
                <label><span>ふりがな</span><input name={`p__i__-${key}-kana`} type="text" maxlength="100" placeholder={kana} /></label>
              </div>
            </div>
          ))}
          <p class="p-reserve__help">父・母のどちらかお一人だけでも構いません。<br />上の「お名前」「生年月日」は、お子さまご本人のものをご入力ください。</p>
          <p class="p-reserve__help p-reserve__copied" data-parents-copied hidden>前の方と同じ父母のお名前を入れました。違う場合は書き換えてください。</p>
        </div>
      </div>
      <div class="p-contact-form__row" data-extra="car" hidden>
        <div class="p-contact-form__label"><label for="p__i__-car">車名とナンバー</label><span class="p-required">必須</span></div>
        <div class="p-contact-form__field">
          <textarea id="p__i__-car" name="p__i__-car" rows="2" maxlength="500" data-required placeholder={'トヨタ　プリウス\n姫路300 あ 11-11'}></textarea>
        </div>
      </div>
    </fieldset>
  </template>

  <h2 class="p-reserve__heading">ご連絡先</h2>
  <p class="p-reserve__help">お子さまのご祈祷の場合は、保護者の方のお電話番号・メールアドレスをご入力ください。</p>

  <div class="p-contact-form__row">
    <div class="p-contact-form__label"><label for="zip">郵便番号</label></div>
    <div class="p-contact-form__field">
      <input id="zip" name="zip" type="text" inputmode="numeric" maxlength="8" placeholder="6781234" autocomplete="postal-code" class="p-reserve__short" aria-describedby="js-zip-status" />
      <p class="p-reserve__help" id="js-zip-status" aria-live="polite">郵便番号を入れると、住所が自動で入ります。</p>
      <div class="p-reserve__candidates" id="js-zip-candidates" hidden></div>
    </div>
  </div>
  <div class="p-contact-form__row">
    <div class="p-contact-form__label"><label for="address">住所</label><span class="p-required">必須</span></div>
    <div class="p-contact-form__field"><input id="address" name="address" type="text" maxlength="300" required autocomplete="street-address" /></div>
  </div>
  <div class="p-contact-form__row">
    <div class="p-contact-form__label"><label for="building">建物名等</label></div>
    <div class="p-contact-form__field"><input id="building" name="building" type="text" maxlength="200" /></div>
  </div>
  <div class="p-contact-form__row">
    <div class="p-contact-form__label"><label for="tel">電話番号</label><span class="p-required">必須</span></div>
    <div class="p-contact-form__field">
      <input id="tel" name="tel" type="tel" maxlength="15" required autocomplete="tel" class="p-reserve__short" />
      <p class="p-reserve__help">当日に連絡のつく電話番号をご記入ください。</p>
    </div>
  </div>
  {!reception && (
  <div class="p-contact-form__row">
    <div class="p-contact-form__label"><label for="email">メールアドレス</label><span class="p-required">必須</span></div>
    <div class="p-contact-form__field"><input id="email" name="email" type="email" maxlength="200" required autocomplete="email" /></div>
  </div>
  )}

  <h2 class="p-reserve__heading">初穂料・連絡事項</h2>

  {reception ? (
  <div class="p-contact-form__row">
    <div class="p-contact-form__label"><label for="fee-total">初穂料</label><span class="p-required">必須</span></div>
    <div class="p-contact-form__field">
      <div class="p-reserve__fee" id="js-fee-lines" aria-live="polite">ご祈願内容を選ぶと、初穂料の目安が出ます。</div>
      <p class="p-reserve__fee-input"><input id="fee-total" name="fee-total" type="number" inputmode="numeric" min="0" step="1" required class="p-reserve__short" /> 円</p>
      <p class="p-reserve__help">目安の金額を入れています。お心持ちで増やしていただくこともできます。初穂料は、このあと受付でお納めください。</p>
    </div>
  </div>
  ) : (
  <div class="p-contact-form__row">
    <div class="p-contact-form__label" id="payment-label">初穂料の納め方<span class="p-required">必須</span></div>
    <div class="p-contact-form__field p-reserve__choices" role="radiogroup" aria-labelledby="payment-label">
      <label data-payment-onsite><input type="radio" name="payment" value="当日ご社頭でお納め" required /> 当日ご社頭でお納め</label>
      <label><input type="radio" name="payment" value="事前にクレジットカードでお納め" /> 事前にクレジットカードでお納め</label>
      <label><input type="radio" name="payment" value="その他" /> その他（下の「連絡事項」にご記入ください）</label>
      <p class="p-reserve__help">{advance
        ? 'クレジットカードの場合は、お申し込みの後にお送りするメールで納め方をお知らせいたします。'
        : 'クレジットカードの場合は、予約確定後に納め方をメールでお知らせいたします。'}</p>
    </div>
  </div>
  )}
  <div class="p-contact-form__row">
    <div class="p-contact-form__label"><label for="message">連絡事項</label><span class="p-required" id="js-message-required" hidden>必須</span></div>
    <div class="p-contact-form__field">
      <textarea id="message" name="message" rows="5" maxlength="2000"></textarea>
      <p class="p-reserve__help" id="js-message-help">ご要望などがあればご記入ください。</p>
    </div>
  </div>

  <!-- スパム対策（人には見えない項目） -->
  <div class="u-visually-hidden" aria-hidden="true">
    <label>空欄のままにしてください <input type="text" name="website" tabindex="-1" autocomplete="off" /></label>
  </div>
  <div class="cf-turnstile" data-sitekey={siteKey} data-language="ja"></div>
  {reception ? (
    <p class="p-contact-form__note">※ 「申し込む」を押すと受付が確定し、社務所で申込書が印刷されます。<br />※ 次の画面に出る受付番号を、受付でお伝えください。</p>
  ) : advance ? (
    <p class="p-contact-form__note">※ 送信後、ご入力のメールアドレスに「申込番号」の入ったメールが届きます。当日は、受付で申込番号をお伝えください。<br />※ メールが届かない場合は、迷惑メールのフォルダもご確認ください。</p>
  ) : (
    <p class="p-contact-form__note">※ 送信の時点では仮予約です。神社で確認のうえ、ご予約確定のメールをお送りします。<br />※ 送信後、ご入力のメールアドレスに受付のメールが届きます。届かない場合は、迷惑メールのフォルダもご確認ください。</p>
  )}
  <p class="p-contact-form__error" id="js-form-error" role="alert" hidden></p>
  <p class="p-contact-form__submit"><button type="submit" class="p-btn">{reception ? '申し込む' : advance ? '事前申し込みを送信する' : '仮予約を送信する'}</button></p>
</form>

<script>
  import { KUROBOSHI_YEAR, MAX_PERSONS, PRAYER_OTHER, advanceDates, dateLabel, feeSummary, yearFortune } from '../lib/reservation';

  type Day = { date: string; label: string; slots: { time: string; available: boolean }[] };

  const form = document.getElementById('js-reserve-form') as HTMLFormElement;
  /** 事前申し込み（時刻を選ばない）かどうか */
  const advance = form.dataset.mode === 'advance';
  /** 当日受付（その場で受付が確定する） */
  const reception = form.dataset.mode === 'reception';
  /** 当日受付で、今日が黒星祈願祭の日か（黒星・厄年の目安を出す） */
  let kuroboshiDay = false;
  const submitLabel = reception ? '申し込む' : advance ? '事前申し込みを送信する' : '仮予約を送信する';
  const dateSelect = form.querySelector<HTMLSelectElement>('#date')!;
  const times = document.getElementById('js-times');
  const slotsError = document.getElementById('js-slots-error');
  const error = document.getElementById('js-form-error')!;
  const button = form.querySelector('button[type=submit]') as HTMLButtonElement;
  const persons = document.getElementById('js-persons')!;
  const personTemplate = document.getElementById('js-person-template') as HTMLTemplateElement;
  const addPerson = document.getElementById('js-add-person') as HTMLButtonElement;
  let days: Day[] = [];
  /** 欄の名前に付ける番号（削除しても重ならないよう、増やすだけにする） */
  let nextIndex = 0;

  /** 選ばれているご祈祷方法（事前申し込みは来社だけ） */
  const methodValue = () =>
    advance || reception ? '来社' : form.querySelector<HTMLInputElement>('input[name=method]:checked')?.value ?? '';

  /** ご祈祷方法に合わせて、日時の欄と「当日ご社頭でお納め」を出し入れする */
  const toggleVisit = () => {
    const visit = methodValue() === '来社';
    const visitFields = form.querySelector<HTMLElement>('[data-show="visit"]');
    if (visitFields) visitFields.hidden = !visit;
    // 郵送では社頭でお納めいただけないので、選択肢ごと隠す（選んでいたら外す）
    const onsite = form.querySelector<HTMLElement>('[data-payment-onsite]');
    if (onsite) {
      onsite.hidden = !visit;
      if (!visit) onsite.querySelector('input')!.checked = false;
    }
    togglePayment();
  };

  /** 納め方で「その他」を選んだら、連絡事項を必須にする */
  const message = form.querySelector<HTMLTextAreaElement>('#message')!;
  const togglePayment = () => {
    const other = form.querySelector<HTMLInputElement>('input[name=payment]:checked')?.value === 'その他';
    document.getElementById('js-message-required')!.hidden = !other;
    message.toggleAttribute('data-required', other);
    document.getElementById('js-message-help')!.textContent = other
      ? '初穂料の納め方のご希望をご記入ください。そのほかご要望があれば、あわせてご記入ください。'
      : 'ご要望などがあればご記入ください。';
  };

  /** その方のご祈願内容に合わせて、追加の欄を出し入れする */
  /** 黒星・八方ふさがり・厄年の目安を、生年月日の下に出す（事前申し込みのページだけ） */
  const REIWA = KUROBOSHI_YEAR - 2018;
  const showFortune = (card: HTMLElement) => {
    const box = card.querySelector<HTMLElement>('[data-fortune]');
    if (!box) return;
    // 当日受付では、黒星祈願祭の日だけ出す（行事の名前に「黒星」が入っている日）
    if (reception && !kuroboshiDay) {
      box.hidden = true;
      return;
    }
    const year = Number(card.querySelector<HTMLInputElement>('input[name$="-birthday"]')!.value.slice(0, 4));
    if (!year || year < 1900 || year > KUROBOSHI_YEAR) {
      box.hidden = true;
      return;
    }
    const gender = card.querySelector<HTMLInputElement>('input[name$="-gender"]:checked')?.value ?? '';
    const f = yearFortune(year, gender);
    const head = `令和${REIWA}年（数え年${f.kazoe}歳）は、`;
    const star = f.happou
      ? `<strong>八方ふさがり</strong>（${f.starName}）にあたります。`
      : f.kuroboshi
        ? `<strong>黒星</strong>（${f.starName}）にあたります。`
        : `黒星にはあたりません（生まれ星：${f.starName}）。`;
    const yaku = f.yaku
      ? `また、<strong>${f.yaku}</strong>にあたります。`
      : gender === '男' || gender === '女'
        ? '厄年にはあたりません。'
        : '性別を選ぶと、厄年かどうかも表示します。';
    box.querySelector('[data-fortune-text]')!.innerHTML = head + star + yaku;
    box.classList.toggle('is-hit', f.happou || f.kuroboshi || !!f.yaku);
    box.hidden = false;
  };

  const toggleExtras = (card: HTMLElement) => {
    const show = new Set(
      [...card.querySelectorAll<HTMLInputElement>('[data-prayers] input:checked')].flatMap((el) => (el.dataset.extras ?? '').split(' ')).filter(Boolean),
    );
    card.querySelectorAll<HTMLElement>('[data-extra]').forEach((el) => {
      el.hidden = !show.has(el.dataset.extra!);
    });
    if (show.has('parents')) copyParents(card);
  };

  // ── 父母のお名前：ごきょうだいなどで2人目以降にも必要なときは、前の方と同じものを入れておく ──
  // 父・母のお名前とふりがなの4つの欄を、ひとまとまりとして写す
  const PARENT_KEYS = ['father', 'father-kana', 'mother', 'mother-kana'];
  const prefixOf = (card: Element) => card.querySelector<HTMLInputElement>('input[name$="-sei"]')!.name.replace(/-sei$/, '');
  const parentFields = (card: Element) => PARENT_KEYS.map((k) => card.querySelector<HTMLInputElement>(`input[name="${prefixOf(card)}-${k}"]`)!);
  const parentValues = (card: Element) => JSON.stringify(parentFields(card).map((f) => f.value));
  const setParentValues = (card: Element, json: string) => {
    const values = JSON.parse(json) as string[];
    parentFields(card).forEach((f, n) => (f.value = values[n]));
  };
  const hasParents = (card: Element) => parentFields(card).some((f) => f.value.trim());

  /** 欄が空なら、前の方（入力のある最後の方）の父母のお名前を入れる */
  const copyParents = (card: HTMLElement) => {
    if (hasParents(card)) return;
    const cards = [...persons.querySelectorAll<HTMLElement>('[data-person]')];
    const source = cards
      .slice(0, cards.indexOf(card))
      .reverse()
      .find((c) => !c.querySelector('[data-extra="parents"]')!.hasAttribute('hidden') && hasParents(c));
    if (!source) return;
    const values = parentValues(source);
    setParentValues(card, values);
    card.dataset.parentsCopied = values;
    card.dataset.parentsLast = values;
    // 写し元も写したものなら、大元の方を覚えておく（大元を直したら、写した欄がすべてそろうように）
    card.dataset.parentsFrom = source.dataset.parentsCopied !== undefined && source.dataset.parentsFrom ? source.dataset.parentsFrom : prefixOf(source);
    card.querySelector<HTMLElement>('[data-parents-copied]')!.hidden = false;
  };

  /** 父母のお名前を書き換えたとき：自分で直したら「自動で入れた」印を外し、写した先の欄にも反映する */
  persons.addEventListener('input', (e) => {
    const field = e.target as HTMLInputElement;
    if (!field.closest?.('[data-parents]')) return;
    const card = field.closest<HTMLElement>('[data-person]')!;
    const before = card.dataset.parentsLast ?? JSON.stringify(PARENT_KEYS.map(() => ''));
    const now = parentValues(card);
    if (card.dataset.parentsCopied !== undefined && now !== card.dataset.parentsCopied) {
      delete card.dataset.parentsCopied;
      delete card.dataset.parentsFrom;
      card.querySelector<HTMLElement>('[data-parents-copied]')!.hidden = true;
    }
    const me = prefixOf(card);
    persons.querySelectorAll<HTMLElement>('[data-person]').forEach((other) => {
      if (other.dataset.parentsFrom === me && other.dataset.parentsCopied === before && parentValues(other) === before) {
        setParentValues(other, now);
        other.dataset.parentsCopied = now;
        other.dataset.parentsLast = now;
      }
    });
    card.dataset.parentsLast = now;
  });

  /** 「ご祈祷を受ける方（1人目）」「（2人目）」…の見出しと、追加ボタンの表示を整える */
  const renumber = () => {
    const cards = [...persons.querySelectorAll<HTMLElement>('[data-person]')];
    cards.forEach((card, n) => {
      card.querySelector('[data-person-label]')!.textContent = `ご祈祷を受ける方（${n + 1}人目）`;
      card.querySelector<HTMLElement>('[data-remove]')!.hidden = n === 0;
    });
    addPerson.hidden = cards.length >= MAX_PERSONS;
  };

  const createPerson = () => {
    const i = nextIndex++;
    const html = personTemplate.innerHTML.replace(/__i__/g, String(i));
    const wrap = document.createElement('div');
    wrap.innerHTML = html;
    const card = wrap.firstElementChild as HTMLElement;
    card.querySelector('[data-prayers]')!.addEventListener('change', (e) => {
      (e.currentTarget as HTMLElement).classList.remove('is-invalid');
      toggleExtras(card);
    });
    // 生年月日・性別が変わったら、黒星・厄年の目安を出し直す
    card.addEventListener('input', (e) => {
      if ((e.target as HTMLInputElement).matches('input[name$="-birthday"], input[name$="-gender"]')) showFortune(card);
    });
    card.addEventListener('change', (e) => {
      if ((e.target as HTMLInputElement).matches('input[name$="-birthday"], input[name$="-gender"]')) showFortune(card);
    });
    card.querySelector('[data-remove]')!.addEventListener('click', () => {
      card.remove();
      renumber();
      addPerson.focus();
    });
    persons.appendChild(card);
    toggleExtras(card);
    renumber();
    return card;
  };

  addPerson.addEventListener('click', () => {
    const first = persons.querySelector<HTMLElement>('[data-person]');
    const card = createPerson();
    // ご家族のことが多いので、姓とふりがな（せい）は1人目と同じものを入れておく
    for (const key of ['sei', 'sei-kana']) {
      const from = first?.querySelector<HTMLInputElement>(`input[name$="-${key}"]`);
      const to = card.querySelector<HTMLInputElement>(`input[name$="-${key}"]`)!;
      if (from?.value) to.value = from.value;
    }
    const sei = card.querySelector<HTMLInputElement>('input[name$="-sei"]')!;
    (sei.value ? card.querySelector<HTMLInputElement>('input[name$="-mei"]')! : sei).focus({ preventScroll: true });
    card.scrollIntoView({ behavior: 'smooth', block: 'start' });
  });

  createPerson();

  const renderTimes = () => {
    if (!times) return;
    const day = days.find((d) => d.date === dateSelect.value);
    times.innerHTML = '';
    if (!day) {
      times.innerHTML = '<p class="p-reserve__help">先に日にちを選んでください。</p>';
      return;
    }
    for (const s of day.slots) {
      const label = document.createElement('label');
      label.className = 'p-reserve__time';
      label.innerHTML = `<input type="radio" name="time" value="${s.time}" ${s.available ? '' : 'disabled'} /><span>${s.time.replace(/^0/, '')}</span>`;
      if (!s.available) label.title = '受付できません';
      times.appendChild(label);
    }
  };

  const loadSlots = async () => {
    if (advance || reception || !slotsError) return;
    const keep = dateSelect.value;
    dateSelect.disabled = true;
    slotsError.hidden = true;
    try {
      const res = await fetch('/api/reservation/slots', { cache: 'no-store' });
      const data = (await res.json()) as { ok: boolean; dates?: Day[] };
      if (!res.ok || !data.ok || !data.dates) throw new Error(String(res.status));
      days = data.dates;
      dateSelect.innerHTML = '<option value="">選んでください</option>';
      for (const d of days) {
        const free = d.slots.some((s) => s.available);
        const opt = new Option(free ? d.label : `${d.label}　受付できません`, d.date);
        opt.disabled = !free;
        dateSelect.add(opt);
      }
      if (days.some((d) => d.date === keep && d.slots.some((s) => s.available))) dateSelect.value = keep;
      dateSelect.disabled = false;
    } catch {
      days = [];
      dateSelect.innerHTML = '<option value="">読み込めませんでした</option>';
      slotsError.hidden = false;
    }
    renderTimes();
  };

  // ── 郵便番号から住所を入れる（public/zip/ に置いた日本郵便のデータを使う） ──
  const zip = form.querySelector<HTMLInputElement>('#zip')!;
  const address = form.querySelector<HTMLInputElement>('#address')!;
  const zipStatus = document.getElementById('js-zip-status')!;
  const zipCandidates = document.getElementById('js-zip-candidates')!;
  const ZIP_HELP = zipStatus.textContent!;
  const zipFiles = new Map<string, Promise<Record<string, string[]>>>();
  /** 最後に自動で入れた住所（その後ろに書き足された番地は残す） */
  let autoFilled = '';

  const zipDigits = () =>
    zip.value.replace(/[０-９]/g, (c) => String.fromCharCode(c.charCodeAt(0) - 0xfee0)).replace(/\D/g, '');

  const applyAddress = (value: string) => {
    const rest = autoFilled && address.value.startsWith(autoFilled) ? address.value.slice(autoFilled.length) : '';
    address.value = value + rest;
    autoFilled = value;
    address.classList.remove('is-invalid');
    zipCandidates.hidden = true;
    zipStatus.textContent = rest ? '住所を入れ直しました。' : '住所を入れました。続けて番地などをご入力ください。';
    if (!rest) {
      address.focus();
      address.setSelectionRange(address.value.length, address.value.length);
    }
  };

  const lookupAddress = async () => {
    const code = zipDigits();
    zipCandidates.hidden = true;
    zipCandidates.innerHTML = '';
    if (code.length !== 7) {
      zipStatus.textContent = ZIP_HELP;
      return;
    }
    const prefix = code.slice(0, 3);
    let data: Record<string, string[]>;
    try {
      if (!zipFiles.has(prefix)) {
        zipFiles.set(prefix, fetch(`/zip/${prefix}.json`).then((r) => (r.ok ? r.json() : {})));
      }
      data = await zipFiles.get(prefix)!;
    } catch {
      zipFiles.delete(prefix);
      zipStatus.textContent = '住所を読み込めませんでした。住所欄に直接ご入力ください。';
      return;
    }
    if (zipDigits() !== code) return; // 読み込みの間に番号が変わった
    const found = data[code] ?? [];
    if (!found.length) {
      zipStatus.textContent = 'この郵便番号の住所が見つかりませんでした。住所欄に直接ご入力ください。';
      return;
    }
    // 住所欄が空か、前に自動で入れたものなら、そのまま入れる。手で書いた住所は勝手に書き換えない
    const free = !address.value.trim() || (autoFilled !== '' && address.value.startsWith(autoFilled));
    if (found.length === 1 && free) {
      applyAddress(found[0]);
      return;
    }
    zipStatus.textContent = found.length > 1
      ? 'この郵便番号には複数の地域があります。あてはまるものを選んでください。'
      : '住所欄に入れる場合は、下の住所を押してください。';
    for (const value of found) {
      const b = document.createElement('button');
      b.type = 'button';
      b.textContent = value;
      b.addEventListener('click', () => applyAddress(value));
      zipCandidates.appendChild(b);
    }
    zipCandidates.hidden = false;
  };

  zip.addEventListener('input', lookupAddress);

  // ── 当日受付の初穂料：ご祈願内容から目安を出し、その金額以上で入力できるようにする ──
  const initFee = () => {
    const lines = document.getElementById('js-fee-lines')!;
    const input = form.querySelector<HTMLInputElement>('#fee-total')!;
    /** ご本人が金額を書き換えたか（書き換えていなければ、目安が変わったら合わせる） */
    let edited = false;
    input.addEventListener('input', () => {
      edited = true;
    });
    const update = () => {
      const people = [...persons.querySelectorAll<HTMLElement>('[data-person]')].map((card) => ({
        prayerNames: [...card.querySelectorAll<HTMLInputElement>('[data-prayers] input:checked')].map((c) =>
          c.value === PRAYER_OTHER ? 'その他のご祈願' : c.value,
        ),
        haraobi: card.querySelector<HTMLInputElement>('input[name$="-haraobi"]:checked')?.value,
      }));
      const fee = feeSummary(people);
      if (!fee.total) {
        lines.textContent = 'ご祈願内容を選ぶと、初穂料の目安が出ます。';
        input.min = '0';
        if (!edited) input.value = '';
        return;
      }
      lines.innerHTML = fee.text.split('\n').map((l) => `<span>${l.replace(/[&<>]/g, '')}</span>`).join('');
      input.min = String(fee.total);
      if (!edited || Number(input.value) < fee.total) {
        input.value = String(fee.total);
        edited = false;
      }
    };
    persons.addEventListener('change', update);
    persons.addEventListener('click', (e) => {
      // 「この方を削除」のあと
      if ((e.target as HTMLElement).closest('[data-remove]')) setTimeout(update);
    });
    update();
  };

  const showError = (message: string) => {
    error.textContent = message;
    error.hidden = false;
    error.scrollIntoView({ behavior: 'smooth', block: 'center' });
  };

  form.querySelectorAll('input[name=method]').forEach((el) => el.addEventListener('change', toggleVisit));
  form.querySelectorAll('input[name=payment]').forEach((el) => el.addEventListener('change', togglePayment));
  // 入力し直した欄は、赤い枠をすぐに外す
  form.addEventListener('input', (e) => {
    const el = e.target as HTMLElement;
    el.classList.remove('is-invalid');
    el.closest('.p-contact-form__field.is-invalid')?.classList.remove('is-invalid');
  });
  dateSelect.addEventListener('change', renderTimes);
  toggleVisit();
  if (reception) {
    // 当日受付：境内の QR コードの URL に入っている合言葉を、送信のときに一緒に送る
    const key = new URLSearchParams(location.search).get('k') ?? '';
    (form.elements.namedItem('k') as HTMLInputElement).value = key;
    initFee();
    // 今日の受付の様子（記号が今日のものか、受付時間か、行事の名前）を確かめる
    const closed = (message: string) => {
      showError(message);
      button.disabled = true;
    };
    if (!key) {
      closed('このページは、神社に掲示している今日の QR コードから開いてください。');
    } else {
      fetch(`/api/reception/today?k=${encodeURIComponent(key)}`, { cache: 'no-store' })
        .then((res) => res.json())
        .then((t: { ok: boolean; error?: string; open?: boolean; label?: string; from?: string; to?: string; event?: string }) => {
          if (!t.ok) return closed(t.error || 'ただいま受付できません。社務所の受付でお申し込みください。');
          const hours = t.from && t.to ? `（受付時間 ${t.from.replace(/^0/, '')}〜${t.to.replace(/^0/, '')}）` : '';
          const eventEl = document.getElementById('js-reception-event');
          if (t.event && eventEl) {
            eventEl.innerHTML = `<strong></strong><span></span>`;
            eventEl.querySelector('strong')!.textContent = t.event;
            eventEl.querySelector('span')!.textContent = `${t.label ?? ''}の当日受付${hours}`;
            eventEl.hidden = false;
            document.title = `${t.event} ${document.title}`;
          }
          kuroboshiDay = !!t.event?.includes('黒星');
          persons.querySelectorAll<HTMLElement>('[data-person]').forEach(showFortune);
          if (!t.open) closed(`ただいま、こちらでの受付の時間外です${hours}。社務所の受付でお申し込みください。`);
        })
        .catch(() => closed('受付の様子を確かめられませんでした。ページを再読み込みしていただくか、社務所の受付でお申し込みください。'));
    }
  } else if (advance) {
    // 事前申し込み：締め切り前の日だけを選べるようにする（締め切りは送信の時にもう一度確かめる）
    const open = advanceDates();
    for (const key of open) dateSelect.add(new Option(dateLabel(key), key));
    if (!open.length) {
      document.getElementById('js-advance-closed')!.hidden = false;
      dateSelect.disabled = true;
      button.disabled = true;
    }
  } else {
    loadSlots();
  }

  form.addEventListener('submit', async (e) => {
    e.preventDefault();
    error.hidden = true;
    form.querySelectorAll('.is-invalid').forEach((el) => el.classList.remove('is-invalid'));

    // 画面に出ている欄だけを確認する
    const visible = (el: Element) => !el.closest('[hidden]');
    const missing: Element[] = [];
    form.querySelectorAll<HTMLInputElement | HTMLTextAreaElement | HTMLSelectElement>('input[required], textarea[required], select[required]').forEach((el) => {
      if (!visible(el)) return;
      const empty = el instanceof HTMLInputElement && el.type === 'radio'
        ? !form.querySelector(`input[name="${el.name}"]:checked`)
        : !el.value.trim() || !el.checkValidity();
      if (empty) missing.push(el.type === 'radio' ? el.closest('.p-contact-form__field')! : el);
    });
    // ご祈願内容によって出る欄（出ているときだけ必須）
    form.querySelectorAll<HTMLInputElement | HTMLTextAreaElement>('[data-required]').forEach((el) => {
      if (!visible(el)) return;
      const empty = el instanceof HTMLInputElement && el.type === 'radio'
        ? !form.querySelector(`input[name="${el.name}"]:checked`)
        : !el.value.trim();
      if (empty) missing.push(el.type === 'radio' ? el.closest('.p-contact-form__field')! : el);
    });
    // 父母のお名前：出ているときは、父・母のどちらか1人以上。お名前を入れた方は、ふりがなも
    persons.querySelectorAll<HTMLElement>('[data-person]').forEach((card) => {
      if (card.querySelector('[data-extra="parents"]')!.hasAttribute('hidden')) return;
      const [father, fatherKana, mother, motherKana] = parentFields(card);
      if (!father.value.trim() && !mother.value.trim()) missing.push(father, mother);
      if (father.value.trim() && !fatherKana.value.trim()) missing.push(fatherKana);
      if (mother.value.trim() && !motherKana.value.trim()) missing.push(motherKana);
    });
    // ご祈願内容は、お一人につき1つ以上
    persons.querySelectorAll<HTMLElement>('[data-prayers]').forEach((el) => {
      if (!el.querySelector('input:checked')) missing.push(el);
    });
    const visit = methodValue() === '来社' && !reception; // 当日受付は日時を選ばない
    if (visit && !dateSelect.value) missing.push(dateSelect);
    if (visit && times && !form.querySelector('input[name=time]:checked')) missing.push(times);

    if (missing.length) {
      missing.forEach((el) => el.classList.add('is-invalid'));
      const feeInput = form.querySelector<HTMLInputElement>('#fee-total');
      if (feeInput && missing.includes(feeInput) && feeInput.value) {
        feeInput.scrollIntoView({ behavior: 'smooth', block: 'center' });
        showError(`初穂料は ${Number(feeInput.min).toLocaleString('ja-JP')}円以上でご入力ください。`);
        return;
      }
      (missing[0] as HTMLElement).scrollIntoView({ behavior: 'smooth', block: 'center' });
      showError('入力されていない項目があります。赤い枠の項目をご確認ください。');
      return;
    }

    button.disabled = true;
    button.textContent = '送信中…';
    try {
      const res = await fetch(form.action, { method: 'POST', body: new FormData(form) });
      const data = (await res.json().catch(() => ({}))) as {
        ok?: boolean; error?: string; refresh?: boolean; step?: string; type?: string; detail?: string; no?: string; total?: number;
      };
      if (res.ok && data.ok) {
        window.location.href = reception
          ? `/reception/thanks/?${new URLSearchParams({ no: data.no ?? '', total: String(data.total ?? '') })}`
          : advance
            ? `/reservation/advance/thanks/?no=${encodeURIComponent(data.no ?? '')}`
            : '/reservation/thanks/';
        return;
      }
      if (data.refresh) await loadSlots();
      // 受け付けられなかった原因を小さく添える（お電話の際に神社で原因を調べられるように）
      const code = [data.step, data.type, data.detail].filter(Boolean).join(' / ');
      showError((data.error || '送信に失敗しました。時間をおいて再度お試しいただくか、お電話でご予約ください。') + (code ? `\n（${code}）` : ''));
    } catch {
      showError('通信エラーが発生しました。時間をおいて再度お試しください。');
    }
    button.disabled = false;
    button.textContent = submitLabel;
    (window as unknown as { turnstile?: { reset: () => void } }).turnstile?.reset();
  });
</script>
